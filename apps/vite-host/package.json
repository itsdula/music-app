{
  "name": "@studio/vite-host",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Vite React host proving <Studio /> is framework-agnostic.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build",
    "preview": "vite preview --port 3200 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@studio/platform-browser": "workspace:*",
    "@studio/react": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  },
  "studio": {
    "packageClass": "host"
  }
}
