{
  "name": "@studio/desktop",
  "version": "0.1.0",
  "productName": "Nawa",
  "private": true,
  "description": "Nawa desktop app (Electron): secure main process + preload bridge; the renderer mounts the portable <Studio />.",
  "author": "itsdula",
  "homepage": "https://itsdula.github.io/nawa/",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsdula/nawa.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs --skip-renderer",
    "package": "electron-builder --publish never",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:probe": "node scripts/smoke.mjs --probe",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json"
  },
  "dependencies": {
    "@studio/platform-browser": "workspace:*",
    "@studio/platform-contracts": "workspace:*",
    "@studio/react": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  },
  "studio": {
    "packageClass": "host"
  }
}
