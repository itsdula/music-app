{
  "name": "studio-monorepo",
  "private": true,
  "description": "Studio \u2014 a local-first, portable digital audio workstation.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@studio/web...",
    "dev:vite": "turbo run dev --filter=@studio/vite-host...",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "pnpm codegen && vitest run --passWithNoTests --project unit --project react --project integration --project contracts",
    "test:unit": "pnpm codegen && vitest run --passWithNoTests --project unit --project react",
    "test:integration": "pnpm codegen && vitest run --passWithNoTests --project integration",
    "test:contracts": "vitest run --passWithNoTests --project contracts",
    "test:coverage": "pnpm codegen && vitest run --passWithNoTests --project unit --project react --project integration --project contracts --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:only": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build",
    "test:browser": "pnpm codegen && vitest run --passWithNoTests --project browser",
    "samples": "node scripts/sample-projects/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@studio/audio-dsp": "workspace:*",
    "@studio/domain": "workspace:*",
    "@studio/project-storage": "workspace:*",
    "@studio/test-fixtures": "workspace:*",
    "@studio/vocal-dsp": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
