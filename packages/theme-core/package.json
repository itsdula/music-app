{
  "name": "@studio/theme-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure theme engine: token registry, ThemeConfig schema, colour maths, resolver, CSS and canvas emission, tweakcn interop and presets.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./boot": "./src/boot/index.ts",
    "./schema/theme-config.v1.json": "./schema/theme-config.v1.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "studio": {
    "packageClass": "A"
  }
}
