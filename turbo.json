{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "codegen": {
      "inputs": ["src/**", "scripts/**", "!src/generated/**"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^codegen", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^codegen", "codegen"]
    },
    "dev": {
      "dependsOn": ["^codegen", "^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
